generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Tabel mobil
model Mobil {
  idMobil      Int      @id @default(autoincrement()) @map("id_mobil")
  namaMobil    String   @map("nama_mobil")
  tipe         String
  tahun        Int      @default(2020)
  transmisi    String
  bahanBakar   String   @default("Bensin") @map("bahan_bakar")
  kapasitas    Int
  hargaPerHari Int      @map("harga_per_hari")
  deskripsi    String
  status       String   @default("tersedia") // tersedia | disewa | maintenance
  createdAt    DateTime @default(now()) @map("created_at")

  fotos    FotoMobil[]
  bookings Booking[]

  @@map("mobil")
}

// Tabel foto_mobil (one-to-many dari mobil)
model FotoMobil {
  idFoto  Int    @id @default(autoincrement()) @map("id_foto")
  idMobil Int    @map("id_mobil")
  urlFoto String @map("url_foto")
  urutan  Int    @default(0)

  mobil Mobil @relation(fields: [idMobil], references: [idMobil], onDelete: Cascade)

  @@map("foto_mobil")
}

// Tabel booking - permintaan booking dari customer (bukan transaksi final, tindak lanjut via WhatsApp)
model Booking {
  idBooking     Int      @id @default(autoincrement()) @map("id_booking")
  kodeBooking   String   @unique @map("kode_booking")
  idMobil       Int      @map("id_mobil")
  namaCustomer  String   @map("nama_customer")
  noHp          String   @map("no_hp")
  tglAmbil      DateTime @map("tgl_ambil")
  tglKembali    DateTime @map("tgl_kembali")
  estimasiHari  Int      @map("estimasi_hari")
  denganSopir   Boolean  @default(false) @map("dengan_sopir")
  catatan       String?
  statusBooking String   @default("menunggu_konfirmasi") @map("status_booking")
  buktiTransferUrl String? @map("bukti_transfer_url")
  createdAt     DateTime @default(now()) @map("created_at")

  // Asal klik iklan (kalau booking datang dari iklan Google Ads). Dipakai
  // untuk impor konversi offline "Booking Closing" — lihat
  // server/src/utils/konversiOffline.js. closingAt diisi sekali, saat
  // booking pertama kali dikonfirmasi admin, dan tidak berubah lagi supaya
  // unggahan ulang ke Google Ads tetap terdeteksi sebagai duplikat.
  gclid       String?
  gbraid      String?
  wbraid      String?
  utmCampaign String?   @map("utm_campaign")
  closingAt   DateTime? @map("closing_at")

  mobil Mobil @relation(fields: [idMobil], references: [idMobil])

  @@map("booking")
}

// Tabel admin, berdiri sendiri
model Admin {
  idAdmin  Int    @id @default(autoincrement()) @map("id_admin")
  username String @unique
  password String

  @@map("admin")
}

// Tabel tambahan untuk konten halaman "Tentang Kami" yang dikelola admin
model CompanyProfile {
  id           Int      @id @default(1)
  namaPerusahaan String @default("287 Trans") @map("nama_perusahaan")
  deskripsi    String
  keunggulan   String // JSON stringified array of {judul, deskripsi}
  alamat       String
  mapsEmbedUrl String?  @map("maps_embed_url")
  telepon      String
  whatsapp     String
  email        String
  fotoUrl      String?  @map("foto_url")
  heroFotoUrl  String?  @map("hero_foto_url")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("company_profile")
}

// Tabel tambahan untuk menyimpan pesan dari form kontak
model ContactMessage {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String
  subjek    String?
  pesan     String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_message")
}

// Tabel tambahan untuk testimoni pelanggan yang tampil di Home (dikelola admin)
model Testimoni {
  id        Int      @id @default(autoincrement())
  nama      String
  kota      String
  pesan     String
  rating    Int      @default(5)
  urutan    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("testimoni")
}

// Tabel tambahan untuk FAQ yang tampil di Home (dikelola admin)
model Faq {
  id         Int      @id @default(autoincrement())
  pertanyaan String
  jawaban    String
  urutan     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("faq")
}

// Foto untuk carousel armada di halaman landing iklan. Sengaja terpisah dari
// foto_mobil: yang ini dikurasi khusus untuk iklan (boleh foto suasana, unit
// pilihan, atau angle yang lebih "jualan"), sementara foto_mobil harus apa
// adanya karena dipakai pelanggan untuk menilai unit sebelum booking.
model GaleriArmada {
  id      Int     @id @default(autoincrement())
  urlFoto String  @map("url_foto")
  judul   String?
  urutan  Int     @default(0)
  aktif   Boolean @default(true)

  // Hasil pengaturan crop admin, disimpan sebagai nilai CSS supaya bisa
  // dipakai langsung tanpa mengolah ulang gambar: posisiFokus = object-position
  // (menggeser bagian mana yang tampak), zoom = faktor scale. Keduanya relatif
  // terhadap ukuran frame, jadi hasilnya sama persis di pratinjau admin maupun
  // di halaman publik yang lebarnya berbeda. File asli tidak pernah disentuh,
  // jadi crop bisa diubah berkali-kali tanpa kehilangan kualitas.
  posisiFokus String @default("50% 50%") @map("posisi_fokus")
  zoom        Float  @default(1)

  createdAt DateTime @default(now()) @map("created_at")

  @@map("galeri_armada")
}

// Lead WhatsApp dari pengunjung iklan. Setiap pengunjung yang datang dari
// klik iklan (ada gclid/gbraid/wbraid) dapat satu kode referensi pendek yang
// ikut tertulis di pesan WA-nya. Saat chat masuk, admin mencari kode itu di
// panel dan menandai tahapnya (qualified / closing). Tahap itulah yang
// diunggah balik ke Google Ads sebagai konversi offline, supaya iklan belajar
// dari penyewa sungguhan, bukan dari semua orang yang sekadar klik WA.
model LeadWa {
  id           Int       @id @default(autoincrement())
  kodeRef      String    @unique @map("kode_ref")
  gclid        String?
  gbraid       String?
  wbraid       String?
  utmSource    String?   @map("utm_source")
  utmMedium    String?   @map("utm_medium")
  utmCampaign  String?   @map("utm_campaign")
  lokasiTombol String?   @map("lokasi_tombol")
  namaMobil    String?   @map("nama_mobil")
  halaman      String?
  jumlahKlik   Int       @default(1) @map("jumlah_klik")
  status       String    @default("baru") // baru | qualified | closing | tidak_jadi
  qualifiedAt  DateTime? @map("qualified_at")
  closingAt    DateTime? @map("closing_at")
  nilaiClosing Int?      @map("nilai_closing")
  catatan      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([createdAt])
  @@index([status])
  @@map("lead_wa")
}
